<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (Android 8+). Without this file the launcher treats
  ic_launcher.png as a legacy icon: it shrinks the square artwork and pads it
  inside the mask on a white plate, which is why the icon appeared as a small
  square floating in a white circle. The foreground keeps the artwork inside
  the 66dp safe zone so no mask shape crops the cube.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
